# Python venv for the Neon bridge — 395MB of opencv/PyAV/apriltag wheels.
# Recreate with:
#   python3 -m venv bridge/.venv
#   bridge/.venv/bin/python -m pip install -r bridge/requirements.txt
bridge/.venv/
__pycache__/
*.pyc

# Local TLS certificates. Machine-specific and semi-sensitive — regenerate
# with mkcert, see README.
.certs/

# Node deps, if any tooling ever needs them
node_modules/

.DS_Store

# Offline install packages for the bridge, ~190MB. Built by
# bridge/fetch_wheels.sh and published as a GitHub Release asset, not in git.
bridge/wheels/
bridge/petrifeye-offline-packages-*.zip

# MAGNETIC POETRY voice auditions (make-voices.mjs audition) — scratch, not shipped
games/magnetic-poetry/voice/_audition/
# LIVE GAZE: the saved exhibition is written to exhibition/ (keep it, or commit
# it to pin the printed sheets); these are its scratch copy and replaced versions.
exhibition.tmp/
exhibition-archive/
